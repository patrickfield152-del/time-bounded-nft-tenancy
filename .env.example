# Factory account: deploys sites and holds the attestor registry.
NEAR_FACTORY_ACCOUNT=stele.testnet
# Demo site account, created as a direct sub-account of the factory.
NEAR_SITE_ACCOUNT=demo.stele.testnet
# Demo escrow vault account, created as a direct sub-account of the factory.
NEAR_VAULT_ACCOUNT=vault-demo.stele.testnet
# Mock NEP-141 settlement token used by the demo.
NEAR_FT_ACCOUNT=usd.stele.testnet
# Testnet RPC endpoint read by the scripts and the SDK.
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Optional failover list; when set it takes precedence over NEAR_RPC_URL for reads.
# NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
# Optional comma-separated signing keys for native MultiKeySigner rotation on writes.
# NEAR_PRIVATE_KEYS=ed25519:...,ed25519:...
