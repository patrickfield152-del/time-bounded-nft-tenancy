    "build": "tsup src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "near-connect-hooks": "1.1.6"
  },
  "peerDependencies": {
    "@stele/sdk": "^0.1.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@stele/sdk": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "7.0.2"
  }
}
