{
  "name": "@stele/react",
  "version": "0.1.0",
  "description": "React bindings for stele — <Slot>, useSlot, useBuy and the default buy dialog.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
