{
  "name": "@stele/sdk",
  "version": "0.1.0",
  "description": "Client for stele: NEP-171 slot NFTs with time-bounded function-call-key tenancy and NEP-141 settlement on NEAR.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "build": "tsup src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "near-api-js": "7.5.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
